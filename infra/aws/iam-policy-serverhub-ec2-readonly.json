{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ServerHubDescribeEc2ReadOnly",
      "Effect": "Allow",
      "Action": ["ec2:DescribeInstances"],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": ["ap-northeast-1"]
        }
      }
    }
  ]
}
