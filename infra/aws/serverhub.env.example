# ServerHub backend の環境変数（本番 EC2）。
#
# 置き場所: /etc/serverhub/serverhub.env
# 権限:     chown root:serverhub && chmod 600（serverhub ユーザーは読めるが他は不可）
# 注意:     実値を入れたこのファイルは絶対にコミットしない。Git 管理外。
#
# systemd unit（serverhub.service）が EnvironmentFile として読み込む。

# --- プロファイル ---------------------------------------------------------------
# neon: 接続プール設定（application-neon.yml） / prod: Secure Cookie・INFO ログ・
# Swagger 認証必須・db/prod マイグレーション（application-prod.yml）
SPRING_PROFILES_ACTIVE=neon,prod

# --- データベース（Neon） -------------------------------------------------------
# Neon コンソールの接続文字列（JDBC 形式、SSL 必須）
SPRING_DATASOURCE_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
SPRING_DATASOURCE_USERNAME=<neon_user>
SPRING_DATASOURCE_PASSWORD=<neon_password>

# --- AWS EC2 実行状態の参照（FR-CLOUD-01） ------------------------------------
# 認証は EC2 インスタンスプロファイル（IAM ロール）。アクセスキーは置かない。
SERVERHUB_CLOUD_ENABLED=true
SERVERHUB_CLOUD_AWS_REGION=ap-northeast-1
# AWS SDK 既定のリージョン解決にも使われる
AWS_REGION=ap-northeast-1

# --- JVM ----------------------------------------------------------------------
# t3.small(2GiB) 想定。nginx と OS に残す分を考慮して 70%
JAVA_OPTS=-XX:MaxRAMPercentage=70.0
