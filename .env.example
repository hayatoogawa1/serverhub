# ServerHub 環境変数テンプレート
#
# 使い方:
#   cp .env.example .env
#   → .env を編集して実際の値を設定する（.env は Git 管理外）
#
# ここには実際のパスワード・シークレットを書かないこと。
# .env は Makefile / docker compose / (be-run 経由の) Backend から参照される。
# 値にスペース・`#`・`$` を含めないこと（含める場合はシェルの引用規則に従う）。
# 改行コードは LF（.gitattributes で固定。CRLF だと docker compose が値に \r を混ぜる）。

# =============================================================================
# DB 接続先の切り替え
# =============================================================================
# 既定はローカル Docker（オフラインでも動く）。Neon を使う場合は下の NEON ブロックを
# 有効化する。詳細は docs/adr/0003 / README。

# ─────────────────────────────────────────────
# ローカル Docker PostgreSQL（infra/docker/docker-compose.yml が参照）
#   既定。`make db-up` で起動 → `make be-run` は下記 SPRING_DATASOURCE_* が未設定なら
#   application.yml の既定値（localhost:5432 / serverhub / changeme）で接続する。
# ─────────────────────────────────────────────
POSTGRES_USER=serverhub
POSTGRES_PASSWORD=changeme
POSTGRES_DB=serverhub

# ホスト側の公開ポート。ローカルに別の PostgreSQL が 5432 で動いている場合は変更する。
DB_PORT=5432

# ローカルに明示的に合わせたい場合（通常は不要）:
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/serverhub
# SPRING_DATASOURCE_USERNAME=serverhub
# SPRING_DATASOURCE_PASSWORD=changeme

# ─────────────────────────────────────────────
# Neon（クラウド PostgreSQL）を使う場合
#   Neon コンソールの接続文字列（JDBC 形式）を設定し、プロファイルを neon にする。
#   Neon は SSL 必須なので URL に ?sslmode=require を付ける。
# ─────────────────────────────────────────────
# SPRING_PROFILES_ACTIVE=neon
# SPRING_DATASOURCE_URL=jdbc:postgresql://<endpoint>.<region>.aws.neon.tech/<db>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon_user>
# SPRING_DATASOURCE_PASSWORD=<neon_password>

# =============================================================================
# フルスタックのコンテナ起動（infra/docker/docker-compose.app.yml / make app-up）
# =============================================================================
# ブラウザ / curl の入口（frontend = nginx）。backend / db はコンテナ内のみ。
APP_PORT=8080
# 本番デプロイ時のみ prod プロファイルを有効化する（Secure Cookie / X-Forwarded-* 信頼 /
# Swagger 認証必須 / INFO ログ）。開発フルスタックでは未設定のまま。手順は infra/aws/README.md。
# SPRING_PROFILES_ACTIVE=prod
# backend コンテナのログ量（既定は application.yml の DEBUG）。本番寄りは INFO
# LOGGING_LEVEL_COM_SERVERHUB=INFO
# backend の JVM オプション
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0

# =============================================================================
# AWS EC2 実行状態の参照（FR-CLOUD-01 / Phase 9）。既定は無効。
#   有効化すると Backend が ec2:DescribeInstances（参照のみ）を定期実行する。
#   認証は AWS SDK 既定のクレデンシャルチェーン（本番は IAM ロール）。
#   静的アクセスキーはここにも .env にも書かない（コミット対象のため）。
#   IAM ポリシー / デプロイ手順は infra/aws/README.md。
# =============================================================================
# SERVERHUB_CLOUD_ENABLED=true
# SERVERHUB_CLOUD_AWS_REGION=ap-northeast-1
# SERVERHUB_CLOUD_POLL_INTERVAL=PT1M
# SERVERHUB_CLOUD_STALENESS_THRESHOLD=PT5M
#   ローカルで実 AWS を試すときは SSO プロファイルを使う（infra/aws/README.md §3.2-3.4）:
# AWS_PROFILE=serverhub-read-only
# AWS_REGION=ap-northeast-1

# =============================================================================
# （将来）Neon ブランチを CI で使う場合の API 情報。GitHub Actions Secrets 側で管理し、
# ローカル .env には通常書かない。
# =============================================================================
# NEON_API_KEY=
# NEON_PROJECT_ID=
